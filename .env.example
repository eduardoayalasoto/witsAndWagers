# PostgreSQL connection string used by Drizzle ORM (server-side only).
#
# Local Postgres:
#   DATABASE_URL=postgresql://user:password@localhost:5432/wits_wagers
#
# Local Supabase (`supabase start`):
#   DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres
#
# Railway Postgres plugin — reference the private URL from your app service's
# Variables tab so traffic stays on Railway's internal network:
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
#
# Supabase Cloud — use the connection POOLER, not the direct connection,
# especially if you're deploying to Vercel or another serverless platform.
# In Supabase: Settings → Database → Connection string → "Transaction" or
# "Session" mode. The direct connection (db.<project-ref>.supabase.co) is
# IPv6-only on newer projects and unreachable from Vercel's IPv4 network.
#   DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://user:password@localhost:5432/wits_wagers

# Supabase project API URL and anon (public) key, used client-side for
# Realtime broadcast. Find these under Settings → API in your Supabase
# project. This is needed even if your Postgres data lives elsewhere (e.g.
# Railway) — Realtime Broadcast doesn't read from the database.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
